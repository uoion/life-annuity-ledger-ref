# Application settings
APP_ENV=development
LOG_LEVEL=INFO

# CORS origins (comma-separated) — pre-wired for future React/Angular/Vue clients
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database (SQLite default for zero-config offline/CI runs; PostgreSQL in production)
# Example PostgreSQL: postgresql+psycopg://annuity:change_me@db:5432/annuity_ledger
DATABASE_URL=sqlite:///./data/annuity_ledger.db

# Optional Governed AI Explainer (Provider-agnostic OpenAI-compatible HTTP endpoint)
# Compatible with regional Azure OpenAI, AWS Bedrock proxy, local Ollama/vLLM, Gemini, or DeepSeek.
# Leave LLM_API_KEY blank to run 100% offline using the deterministic_template fallback.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=15.0
LLM_MAX_TOKENS=220

# Abuse protection on /api/v1/explain-quote
EXPLAIN_RATE_LIMIT_PER_MINUTE=10
