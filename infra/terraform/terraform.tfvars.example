aws_region          = "af-south-1"
project_name        = "life-annuity-ledger"
environment         = "prod"
container_image     = "ghcr.io/uoion/life-annuity-ledger-ref:0.1.0"
desired_count       = 2
db_instance_class   = "db.t4g.micro"
enable_multi_az     = true
deletion_protection = true
skip_final_snapshot = false
